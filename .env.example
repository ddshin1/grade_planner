# Needed only for "Import syllabus" (AI reading of PDFs and screenshots).
# Copy this file to .env.local and paste your key from https://platform.claude.com
ANTHROPIC_API_KEY=

# Needed on the hosted site for shared class setups (see DEPLOY.md).
# Without them, setups are saved in ./.data on the computer running the site.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
